# CloudTAK Configuration Environment Variables
# Copy this file to cloudtak-config.env and customize for your deployment

# TAK User Group Configuration for New Zealand Emergency Services
CLOUDTAK_Config_group_Blue=New Zealand Police
CLOUDTAK_Config_group_Red=Fire and Emergency New Zealand (FENZ)
CLOUDTAK_Config_group_Yellow=Hato Hone St John
CLOUDTAK_Config_group_White=Wellington Free Ambulance
CLOUDTAK_Config_group_Purple=National Emergency Management Agency (NEMA)
CLOUDTAK_Config_group_Brown=New Zealand Defence Force (NZDF)
CLOUDTAK_Config_group_Maroon=New Zealand Red Cross
CLOUDTAK_Config_group_Orange=Land Search and Rescue New Zealand (LandSAR)
CLOUDTAK_Config_group_Teal=Coastguard New Zealand
CLOUDTAK_Config_group_Green=Department of Conservation (DOC)
CLOUDTAK_Config_group_Cyan=Health New Zealand (Te Whatu Ora)
CLOUDTAK_Config_group_Dark_Blue=New Zealand Customs Service

# Map Configuration - Centered on New Zealand
CLOUDTAK_Config_map_center=174.7762,-41.2865
CLOUDTAK_Config_map_zoom=5
CLOUDTAK_Config_map_pitch=0
CLOUDTAK_Config_map_bearing=0

# Display Defaults - Metric System Configuration
export CLOUDTAK_Config_display_distance="kilometer"
export CLOUDTAK_Config_display_elevation="meter"
export CLOUDTAK_Config_display_speed="km/h"
export CLOUDTAK_Config_display_projection="mercator"
# Weather plugin (cloudtak-plugin-weather). Server-side only; never sent to browsers.
# Plain KEY=value lines: no quotes, no "export". Applied when the API task starts.
# WEATHER_PROXY_KEY MUST be a dedicated weather-proxy client key (providers: ["rainbow"]), not a shared or admin key.
# WEATHER_PROXY_URL=https://utils.test.tak.nz/weather-radar
# WEATHER_PROXY_KEY=
# WEATHER_RATE_LIMIT=900
# SAR travel-time plugin (cloudtak-plugin-sar). Server-side only; never sent to browsers.
# Plain KEY=value lines: no quotes, no "export". Applied when the API task starts.
# SAR_SERVICE_KEY MUST be the dedicated "cloudtak-relay" client key of the SAR engine, not a shared or admin key.
# SAR_SERVICE_URL=https://utils.test.tak.nz/sar
# SAR_SERVICE_KEY=
# SAR_RATE_LIMIT=6  (calculations per user per minute; travel-time and TARR count together)

# Channel folder separator: how the Channels panel turns "BCH - Alerts - MetService" into folders.
# Default is " - " (space, dash, space). Use the same value as TAK Team Manager's
# CHANNEL_FOLDER_SEPARATOR. Applied when the API task starts. ECS keeps quotes as part of the
# value, so CloudTAK strips one matched pair; the quotes keep the spaces visible.
# CHANNEL_FOLDER_SEPARATOR=" - "

# Trusted external tile/sprite CDN origins (comma-separated, include the scheme). They are added to the
# Content-Security-Policy connect-src and img-src, and tiles from them skip the CloudTAK tile proxy.
# Applied when the container starts, so redeploy or restart the API tasks after changing it.
# Keep every origin you already use. https://tiles.openwaters.io is REQUIRED for the Seamap and Seascape
# overlays: without it the browser blocks the chart-symbol sprite and buoys, lights and other point
# symbols do not draw (see docs/OPEN-WATERS-OVERLAYS.md).
# CLOUDTAK_TILE_ORIGINS=https://basemaps.linz.govt.nz,https://mts1.google.com,https://services.arcgisonline.com,https://tiles.test.tak.nz,https://tiles.openwaters.io
